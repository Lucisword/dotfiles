{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "idle_inhibitor",
        "wireplumber",
        "custom/weather",
        "custom/focus",
        "custom/rec",
        "bluetooth",
        "custom/power-profile",
        "battery",
        "tray",
        "clock"
    ],
    "group/tray-group": {
        "orientation": "horizontal",
        "drawer": {
            "click-to-reveal": true,
            "transition-duration": 0,
            "transition-left-to-right": false
        },
        "modules": ["custom/tray-icon", "tray"]
    },
    "custom/tray-icon": {
        "format": "󰀻",
        "tooltip": false
    },
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "persistent-workspaces": {}
    },
    "hyprland/window": {
        "max-length": 50,
        "separate-outputs": true
    },
    "mpris": {
        "format": "{title}",
        "max-length": 20,
        "ellipsis": "..."
    },
    "wireplumber": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": [
            "󰕿",
            "󰖀",
            "󰕾"
        ],
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "network": {
        "format-wifi": "",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤮",
        "tooltip-format": "{essid} ({signalStrength}%)"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}%",
        "format-charging": "{capacity}% 󰂄",
        "format-plugged": "{capacity}% 󰚥",
        "format-full": "",
        "format-discharging": "{capacity}%",
        "tooltip-format": "{time} ({capacity}%)"
    },
    "idle_inhibitor": { "format": "{icon}", "format-icons": { "activated": "󰅶", "deactivated": "󰛊" }, "tooltip-format-activated": "Caffeine ON", "tooltip-format-deactivated": "Caffeine OFF" },
    "bluetooth": { "format": "󰂯", "format-off": "󰂲", "format-disabled": "󰂲", "format-connected": "󰂱", "tooltip-format": "{status}", "tooltip-format-connected": "{device_alias}", "on-click": "/home/lucifer/.local/bin/bt-menu", "on-click-right": "/home/lucifer/.local/bin/bt-toggle" },
    "custom/power-profile": { "exec": "/home/lucifer/.local/bin/pp-status", "return-type": "json", "interval": "once", "signal": 8, "on-click": "/home/lucifer/.local/bin/pp-menu" },
    "custom/rec": { "exec": "/home/lucifer/.local/bin/rec-status", "return-type": "json", "interval": "once", "signal": 9, "on-click": "/home/lucifer/.local/bin/rec-toggle" },
    "custom/weather": { "exec": "/home/lucifer/.local/bin/weather-status", "return-type": "json", "interval": 7200, "signal": 10, "on-click": "pkill -RTMIN+10 waybar" },
    "custom/focus": { "exec": "/home/lucifer/.local/bin/focus-status", "return-type": "json", "interval": 60, "signal": 11, "on-click": "/home/lucifer/.local/bin/focus-toggle", "on-click-right": "/home/lucifer/.local/bin/focus-menu" },
    "clock": {
        "format": "{:%I:%M %p  %d-%m-%Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>"
    }
}
